<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- Mapperとxmlのマッピング -->
<mapper namespace="com.example.repository.NumMapper">

	<!-- 1件登録 -->
	<insert id="insertOne">
			insert into num_judg(
			input_num
			,result
		)
		values(
			#{inputNum}
			,#{result}
		)
	</insert>
	
	<!--前回数値取得-->
	<select id = "findOne">
		SELECT *
		FROM num_judg
		ORDER BY id DESC
		LIMIT 1
	</select>

</mapper>
